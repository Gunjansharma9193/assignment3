using System;

class Student
{
    public int RollNumber;
    public string Name;
    public string Course;
    public int Semester;

    public Student(int rollNumber, string name, string course, int semester)
    {
        RollNumber = rollNumber;
        Name = name;
        Course = course;
        Semester = semester;
    }

    public override bool Equals(object obj)
    {
        Student s = obj as Student;

        return s != null
               RollNumber == s.RollNumber &&
               Name == s.Name &&
               Course == s.Course &&
               Semester == s.Semester;
    }

    public override int GetHashCode()
    {
        return RollNumber.GetHashCode();
    }
}

class Program3
{
    static void Main6(string[] args)
    {
        Student student1 = new Student(101, "Gunjan", "MCA", 3);
        Student student2 = new Student(101, "Gunjan", "MCA", 3);

        Console.WriteLine("Student 1: " + student1.Name);
        Console.WriteLine("Student 2: " + student2.Name);

        Console.WriteLine("Are both students equal? " +
                          student1.Equals(student2));

        Console.ReadLine();
    }
}
